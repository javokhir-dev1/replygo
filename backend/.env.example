# ===== ReplyGo — bitta foydalanuvchi konfiguratsiyasi =====

# --- Panel logini ---
# Panelga kirish uchun login/parol. Uchalasi ham to'ldirilishi SHART,
# aks holda backend ishga tushmaydi.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# JWT imzo kaliti — `openssl rand -hex 32` bilan yarating (kamida 32 belgi).
# O'zgartirilsa barcha mavjud tokenlar bekor bo'ladi (majburiy chiqish).
JWT_SECRET=
# Token amal qilish muddati: 7d, 24h, 30m ...
JWT_EXPIRES_IN=7d

# --- Instagram / Meta ---
# Instagram Graph API uzoq muddatli access token
IG_ACCESS_TOKEN=EAAG...
# Instagram Business Account ID (bot akkaunt ID)
IG_ACCOUNT_ID=1784xxxxxxxxxxx
# Meta App Secret (webhook imzosini tekshirish uchun; ixtiyoriy lekin tavsiya etiladi)
INSTAGRAM_APP_SECRET=
# Webhookni Meta panelida ulashda ishlatiladigan tasdiqlash tokeni
WEBHOOK_VERIFY_TOKEN=replygo_verify_123

# --- Ma'lumotlar bazasi (PostgreSQL) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/replygo

# --- Server ---
PORT=4000
# Frontend origin (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# --- Limitlar (ixtiyoriy) ---
# Bir foydalanuvchiga 24 soatda nechta javob berish mumkin
PER_USER_COMMENT_LIMIT=10

# --- Navbat (BullMQ + Redis) ---
# Redis ulanish manzili (lokal: redis://localhost:6379)
REDIS_URL=redis://localhost:6379
# Xato bo'lganda qayta urinishlar soni (ikkala navbat uchun)
QUEUE_ATTEMPTS=3

# KOMMENTLAR navbati — sekin/xavfsiz (spam himoyasi)
QUEUE_COMMENT_CONCURRENCY=1
QUEUE_COMMENT_RATE_MAX=20
QUEUE_COMMENT_RATE_DURATION_MS=60000

# DM (tugma-bosish) navbati — tez/mustaqil (foydalanuvchi javob kutyapti)
QUEUE_MESSAGING_CONCURRENCY=5
QUEUE_MESSAGING_RATE_MAX=30
QUEUE_MESSAGING_RATE_DURATION_MS=60000

# Proaktiv throttle: Instagram header'idagi ish foizi shu chegaradan oshsa,
# limitga urilishdan oldin navbat USAGE_PAUSE_MS ga sekinlashadi
IG_USAGE_PAUSE_THRESHOLD=90
IG_USAGE_PAUSE_MS=60000
