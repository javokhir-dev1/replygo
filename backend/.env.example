# ===== ReplyGo — bitta foydalanuvchi konfiguratsiyasi =====

# --- Instagram / Meta ---
# Instagram Graph API uzoq muddatli access token
IG_ACCESS_TOKEN=EAAG...
# Instagram Business Account ID (bot akkaunt ID)
IG_ACCOUNT_ID=1784xxxxxxxxxxx
# Meta App Secret (webhook imzosini tekshirish uchun; ixtiyoriy lekin tavsiya etiladi)
INSTAGRAM_APP_SECRET=
# Webhookni Meta panelida ulashda ishlatiladigan tasdiqlash tokeni
WEBHOOK_VERIFY_TOKEN=replygo_verify_123

# --- Ma'lumotlar bazasi (PostgreSQL) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/replygo

# --- Server ---
PORT=4000
# Frontend origin (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# --- Navbat (BullMQ + Redis) ---
# Redis ulanish manzili (lokal: redis://localhost:6379)
REDIS_URL=redis://localhost:6379
# Xato bo'lganda qayta urinishlar soni (ikkala navbat uchun)
QUEUE_ATTEMPTS=3

# KOMMENTLAR navbati — sekin/xavfsiz (spam himoyasi)
QUEUE_COMMENT_CONCURRENCY=1
QUEUE_COMMENT_RATE_MAX=20
QUEUE_COMMENT_RATE_DURATION_MS=60000

# DM (tugma-bosish) navbati — tez/mustaqil (foydalanuvchi javob kutyapti)
QUEUE_MESSAGING_CONCURRENCY=5
QUEUE_MESSAGING_RATE_MAX=30
QUEUE_MESSAGING_RATE_DURATION_MS=60000

# Proaktiv throttle: Instagram header'idagi ish foizi shu chegaradan oshsa,
# limitga urilishdan oldin navbat USAGE_PAUSE_MS ga sekinlashadi
IG_USAGE_PAUSE_THRESHOLD=90
IG_USAGE_PAUSE_MS=60000

# --- Telegram loglari ---
# @BotFather dan olingan token. Bo'sh qoldirilsa Telegram loglari o'chiq.
TELEGRAM_BOT_TOKEN=
# Ixtiyoriy: botga /start yuborilsa chat o'zi ro'yxatga tushadi
TELEGRAM_CHAT_ID=
# Telegram cheklovi: ~20 xabar/daqiqa guruhga. Ko'p log kelsa navbat ushlab turadi.
TELEGRAM_CONCURRENCY=1
TELEGRAM_RATE_MAX=20
TELEGRAM_RATE_DURATION_MS=60000
TELEGRAM_QUEUE_ATTEMPTS=5
# Statistika Mini App manzili (HTTPS shart — Telegram talabi)
TELEGRAM_WEBAPP_URL=https://app.example.com/tg

# --- Ko'p foydalanuvchi: Instagram ulash (OAuth) ---
# Meta dashboard → Instagram → API setup with Instagram login → "Instagram app ID"
INSTAGRAM_APP_ID=
# Meta dashboard'da "Valid OAuth Redirect URIs" ga aynan shu qo'shilishi shart
INSTAGRAM_REDIRECT_URI=https://api.example.com/api/instagram/callback
# Tokenlarni shifrlash kaliti: `openssl rand -hex 32`. Bir marta qo'yib, o'zgartirmang.
TOKEN_ENCRYPTION_KEY=
# ADMIN_USERNAME/ADMIN_PASSWORD endi ixtiyoriy: berilsa, ishga tushganda shu
# foydalanuvchi yaratiladi va eski (egasiz) ma'lumotlar unga biriktiriladi.
# IG_ACCESS_TOKEN/IG_ACCOUNT_ID ham xuddi shunday — bir martalik ko'chirish uchun.

# --- Tezlik va limitlar ---
# Bazadagi `system_settings` jadvalida saqlanadi (keyinchalik admin panelidan).
# Birinchi ishga tushishda standart qiymatlar bilan o'zi to'ldiriladi.
